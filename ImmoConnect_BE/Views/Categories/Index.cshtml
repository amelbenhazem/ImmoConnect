@model IEnumerable<ImmoConnect_BE.Models.Categorie>

@{
    ViewData["Title"] = "Liste des catégories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des catégories</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Créer une nouvelle catégorie
        </a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nom)
                </th>
                <th>
                    Nombre de biens associés
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nom)
                    </td>
                    <td>
                        @(item.BiensImmobiliers?.Count ?? 0)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id_categorie" class="btn btn-sm btn-primary">Modifier</a> |
                        <a asp-action="Details" asp-route-id="@item.Id_categorie" class="btn btn-sm btn-info">Détails</a> |
                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal@(item.Id_categorie)">
                            Supprimer
                        </button>

                        <!-- Modal de confirmation de suppression -->
                        <div class="modal fade" id="deleteModal@(item.Id_categorie)" tabindex="-1" aria-labelledby="deleteModalLabel@(item.Id_categorie)" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="deleteModalLabel@(item.Id_categorie)">Confirmer la suppression</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Êtes-vous sûr de vouloir supprimer la catégorie "@item.Nom" ?
                                         @if (item.BiensImmobiliers?.Count > 0)
                                        {
                                            <div class="alert alert-warning mt-2">
                                                Attention : Cette catégorie contient @item.BiensImmobiliers.Count biens immobiliers.
                                            </div>
                                        }
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                        <form asp-action="DeleteConfirmed" asp-route-id="@item.Id_categorie" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger">Supprimer</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Optional: Add script to handle modal if needed, though Bootstrap handles most of it.
    </script>
} 