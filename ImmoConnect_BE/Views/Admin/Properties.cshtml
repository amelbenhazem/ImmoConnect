@model IEnumerable<ImmoConnect_BE.Models.BienImmobilier>

@{
    ViewData["Title"] = "Gestion des biens immobiliers";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des biens immobiliers</h1>
        <a asp-controller="BiensImmobiliers" asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouveau bien
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Prix</th>
                            <th>Adresse</th>
                            <th>Catégorie</th>
                            <th>Propriétaire</th>
                            <th>Statut</th>
                            <th>Date d'ajout</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var property in Model)
                        {
                            <tr>
                                <td>@property.Titre</td>
                                <td>@property.Prix.ToString("C")</td>
                                <td>@property.Adresse</td>
                                <td>@property.Categorie?.Nom</td>
                                <td>@property.Utilisateur?.Nom @property.Utilisateur?.Prenom</td>
                                <td>
                                    <span class="badge bg-@(property.Statut switch {
                                        "Disponible" => "success",
                                        "Réservé" => "warning",
                                        "Vendu" => "danger",
                                        _ => "secondary"
                                    })">
                                        @property.Statut
                                    </span>
                                </td>
                                <td>@property.Date_ajout.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-controller="BiensImmobiliers" asp-action="Edit" asp-route-id="@property.Id_bien" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i> Modifier
                                        </a>
                                        <a asp-controller="BiensImmobiliers" asp-action="Details" asp-route-id="@property.Id_bien" class="btn btn-sm btn-info">
                                            <i class="fas fa-info-circle"></i> Détails
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal@(property.Id_bien)">
                                            <i class="fas fa-trash"></i> Supprimer
                                        </button>
                                    </div>

                                    <!-- Modal de confirmation de suppression -->
                                    <div class="modal fade" id="deleteModal@(property.Id_bien)" tabindex="-1" aria-labelledby="deleteModalLabel@(property.Id_bien)" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="deleteModalLabel@(property.Id_bien)">Confirmer la suppression</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Êtes-vous sûr de vouloir supprimer le bien @property.Titre ?
                                                    @if (property.DemandesVisite?.Count > 0)
                                                    {
                                                        <div class="alert alert-warning mt-2">
                                                            Attention : Ce bien contient @property.DemandesVisite.Count demandes de visite.
                                                        </div>
                                                    }
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                    <form asp-action="DeleteProperty" asp-route-id="@property.Id_bien" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Supprimer</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Activer les tooltips Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
} 